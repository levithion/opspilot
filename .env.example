# Copy to .env and adjust. Everything has a safe default; with no keys set OpsPilot
# runs fully offline using a deterministic mock LLM and a local hashing embedder. Total cost: $0.

OPSPILOT_ENV=dev                       # dev | prod
OPSPILOT_DATA_DIR=./data
OPSPILOT_KB_DIR=./kb

# --- LLM provider. FREE: mock (offline, default) | ollama (local models, install from ollama.com)
#     PAID (bills per token, blocked unless OPSPILOT_ALLOW_PAID_LLM=true): anthropic | openai
OPSPILOT_LLM_PROVIDER=mock
OPSPILOT_OLLAMA_MODEL=llama3.2          # run `ollama pull llama3.2` first; use a model that supports tool calling
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434/v1
OPSPILOT_ALLOW_PAID_LLM=false           # leave false to guarantee zero API spend
OPSPILOT_ANTHROPIC_MODEL=claude-sonnet-5-5
OPSPILOT_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth: dev (HS256 tokens minted locally) | oidc (Microsoft Entra ID)
OPSPILOT_AUTH_MODE=dev
OPSPILOT_DEV_JWT_SECRET=change-me-dev-only-change-me-dev-only
OPSPILOT_OIDC_TENANT_ID=
OPSPILOT_OIDC_AUDIENCE=                # e.g. api://<app-client-id>

# --- RAG
OPSPILOT_EMBEDDING_BACKEND=hash        # hash | sentence-transformers
OPSPILOT_QDRANT_URL=                   # empty = embedded in-memory Qdrant

# --- Integrations (optional)
OPSPILOT_SLACK_WEBHOOK_URL=
OPSPILOT_TEAMS_WEBHOOK_URL=
OPSPILOT_TICKET_API_URL=               # empty = in-process mock ticketing service

# --- Tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Cost governance
OPSPILOT_DEFAULT_TEAM_BUDGET_USD=50
